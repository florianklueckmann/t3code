{
  "name": "@t3tools/evals",
  "private": true,
  "type": "module",
  "scripts": {
    "bot-sources": "node bot-sources/run.ts",
    "bot-preparation": "node bot-preparation/run.ts",
    "bot-grants": "node bot-grants/run.ts",
    "mcp-tool-use": "node --env-file-if-exists=../.env mcp-tool-use/run.ts",
    "mcp-tool-use:trim-capture": "node mcp-tool-use/trim-capture.ts",
    "mcp-tool-use:regrade": "node mcp-tool-use/regrade.ts",
    "thread-titles": "node --env-file-if-exists=../.env thread-titles/run.ts",
    "pr-content": "node --env-file-if-exists=../.env pr-content/run.ts",
    "voice-cleanup": "node --env-file-if-exists=../.env voice-cleanup/run.ts",
    "test-signal": "node --env-file-if-exists=../.env test-signal/run.ts",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "test": "vp test run --config ../vite.config.ts --dir .",
    "bot-continuation": "node bot-continuation/run.ts",
    "bot-maintenance": "node bot-maintenance/run.ts",
