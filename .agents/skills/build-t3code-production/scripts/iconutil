#!/usr/bin/env node

import { copyFileSync } from "node:fs";

const outputIndex = process.argv.indexOf("-o");
const source = process.env.T3CODE_PRODUCTION_ICNS;
const output = outputIndex >= 0 ? process.argv[outputIndex + 1] : undefined;

if (!source || !output) {
  console.error("T3CODE_PRODUCTION_ICNS and iconutil -o <output> are required");
  process.exit(2);
}

copyFileSync(source, output);
