#!/usr/bin/env node

import { mkdtempSync, readdirSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { basename, join } from "node:path";
import { spawnSync } from "node:child_process";

const args = process.argv.slice(2);
const sourceIndex = args.findIndex((argument) => argument.toLowerCase().endsWith(".svg"));
const outputIndex = args.indexOf("--out");
const sizeIndex = args.indexOf("-z");

const run = (command, commandArgs) => {
  const result = spawnSync(command, commandArgs, { stdio: "inherit" });
  if (result.error) {
    console.error(`${command} failed: ${result.error.message}`);
  }
  return result.status ?? 1;
};

if (
  sourceIndex < 0 ||
  outputIndex < 0 ||
  sizeIndex < 0 ||
  !args[outputIndex + 1] ||
  !args[sizeIndex + 1] ||
  !args[sizeIndex + 2]
) {
  process.exit(run("/usr/bin/sips", args));
}

const source = args[sourceIndex];
const output = args[outputIndex + 1];
const height = args[sizeIndex + 1];
const width = args[sizeIndex + 2];
const thumbnailDir = mkdtempSync(join(tmpdir(), "t3code-prod-svg-"));

try {
  const quickLookStatus = run("qlmanage", ["-t", "-s", "1080", "-o", thumbnailDir, source]);
  let exitCode = quickLookStatus;

  if (exitCode === 0) {
    const thumbnailName = readdirSync(thumbnailDir).find((entry) => entry.endsWith(".png"));
    if (!thumbnailName) {
      console.error(`Quick Look did not produce a PNG for ${basename(source)}`);
      exitCode = 1;
    } else {
      exitCode = run("/usr/bin/sips", [
        "-z",
        height,
        width,
        join(thumbnailDir, thumbnailName),
        "--out",
        output,
      ]);
    }
  }

  process.exitCode = exitCode;
} finally {
  rmSync(thumbnailDir, { recursive: true, force: true });
}
